# Environment Configuration for VoxGaze AI Backend
APP_NAME=VoxGaze AI Backend
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & CORS
SECRET_KEY=supersecretkey_change_in_production
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","*"]

# Firebase Configuration
FIREBASE_PROJECT_ID=voxgaze-ai-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@voxgaze-ai-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=voxgaze-ai-dev.appspot.com
FIREBASE_DATABASE_URL=https://voxgaze-ai-dev-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json

# JWT Configuration
JWT_SECRET=supersecret_jwt_key_change_in_prod_voxgaze
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Future Integration)
DATABASE_URL=sqlite+aiosqlite:///./voxgaze.db

# Third-party integrations
OPENAI_API_KEY=mock_openai_api_key
